{
  "name": "gitty-editor",
  "version": "1.0.0",
  "description": "Gitty Blog Editor - Electron app for writing and publishing posts",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder"
  },
  "keywords": ["blog", "editor", "markdown"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "@octokit/rest": "^20.0.0"
  },
  "build": {
    "appId": "com.gitty.editor",
    "productName": "Gitty Editor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules/**/*"
    ]
  }
}
